<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">KKBOT Dashboard</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-4">v1.0.0</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Width="250">
        <MudNavMenu>
            <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
            <MudNavLink href="/instances" Icon="@Icons.Material.Filled.Computer">Instances</MudNavLink>
            <MudNavLink href="/plugins" Icon="@Icons.Material.Filled.Extension">Installed Plugins</MudNavLink>
            <MudNavLink href="/marketplace" Icon="@Icons.Material.Filled.Store">Marketplace</MudNavLink>
            <MudNavLink href="/visual-scripting" Icon="@Icons.Material.Filled.AutoAwesome">Visual Scripting</MudNavLink>
            <MudNavLink href="/analytics" Icon="@Icons.Material.Filled.Analytics">Analytics</MudNavLink>
            <MudNavLink href="/collaboration" Icon="@Icons.Material.Filled.Groups">Collaboration</MudNavLink>
            <MudNavLink href="/enterprise" Icon="@Icons.Material.Filled.Security">Enterprise</MudNavLink>
            <MudNavLink href="/ai/models" Icon="@Icons.Material.Filled.Psychology">AI Models</MudNavLink>
            <MudNavLink href="/ai/datasets" Icon="@Icons.Material.Filled.Dataset">Datasets</MudNavLink>
            <MudNavLink href="/ai/experiments" Icon="@Icons.Material.Filled.Science">Experiments</MudNavLink>
            <MudNavLink href="/users" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
            <MudNavLink href="/jobs" Icon="@Icons.Material.Filled.Work">Jobs</MudNavLink>
            <MudNavLink href="/logs" Icon="@Icons.Material.Filled.Article">Logs</MudNavLink>
            <MudNavLink href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="pt-4" MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}