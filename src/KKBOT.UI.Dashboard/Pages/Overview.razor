@page "/"
@inject IInstanceRepository InstanceRepository
@inject IJobRepository JobRepository

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-2">Total Instances</MudText>
            <MudText Typo="Typo.h3" Class="text-primary">@_instanceCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-2">Running Jobs</MudText>
            <MudText Typo="Typo.h3" Class="text-success">@_runningJobs</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-2">Pending Jobs</MudText>
            <MudText Typo="Typo.h3" Class="text-warning">@_pendingJobs</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h5" Class="mb-2">Loaded Plugins</MudText>
            <MudText Typo="Typo.h3" Class="text-info">@_pluginCount</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-4">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Recent Instances</MudText>
            @if (_instances.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">No instances found.</MudText>
            }
            else
            {
                <MudTable Items="@_instances" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Module</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd><MudChip Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip></MudTd>
                        <MudTd>@context.Module?.Name</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Success" @onclick="@(() => StartInstance(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Error" @onclick="@(() => StopInstance(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Recent Jobs</MudText>
            @if (_jobs.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">No jobs found.</MudText>
            }
            else
            {
                <MudTable Items="@_jobs" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Type</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Instance</MudTh>
                        <MudTh>Created</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Type</MudTd>
                        <MudTd><MudChip Color="@GetJobStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip></MudTd>
                        <MudTd>@context.InstanceId</MudTd>
                        <MudTd>@context.CreatedAt.ToString("g")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    List<Instance> _instances = new();
    List<Job> _jobs = new();
    int _instanceCount;
    int _runningJobs;
    int _pendingJobs;
    int _pluginCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        _instances = (await InstanceRepository.GetAllAsync(CancellationToken.None)).Take(10).ToList();
        _instanceCount = _instances.Count;
        
        var allJobs = await JobRepository.GetByInstanceAsync(Guid.Empty, CancellationToken.None);
        _jobs = allJobs.Take(10).ToList();
        _runningJobs = allJobs.Count(j => j.Status == JobStatus.Running);
        _pendingJobs = allJobs.Count(j => j.Status == JobStatus.Pending);
        
        _pluginCount = 3; // TODO: Get from PluginLoader
    }

    Color GetStatusColor(InstanceStatus status) => status switch
    {
        InstanceStatus.Running => Color.Success,
        InstanceStatus.Stopped => Color.Error,
        InstanceStatus.Created => Color.Info,
        InstanceStatus.Error => Color.Error,
        _ => Color.Default
    };

    Color GetJobStatusColor(JobStatus status) => status switch
    {
        JobStatus.Running => Color.Success,
        JobStatus.Pending => Color.Warning,
        JobStatus.Completed => Color.Info,
        JobStatus.Failed => Color.Error,
        JobStatus.Cancelled => Color.Default,
        _ => Color.Default
    };

    void StartInstance(Instance instance) { /* TODO */ }
    void StopInstance(Instance instance) { /* TODO */ }
}