    }
    
    private IEnumerable<IGrouping<string, NodeDefinition>> _filteredNodeGroups =>
        _nodeDefinitions
            .Where(d => string.IsNullOrWhiteSpace(_searchNodeType) || 
                       d.Name.Contains(_searchNodeType, StringComparison.OrdinalIgnoreCase) ||
                       d.Category.Contains(_searchNodeType, StringComparison.OrdinalIgnoreCase))
            .GroupBy(d => d.Category)
            .OrderBy(g => g.Key);
    
    private readonly List<NodeDefinition> _nodeDefinitions = new()
    {
        new NodeDefinition { Id = "start", Name = "Start", Category = "Control Flow", Icon = "play_arrow", Color = "#4CAF50" },
        new NodeDefinition { Id = "end", Name = "End", Category = "Control Flow", Icon = "stop", Color = "#F44336" },
        new NodeDefinition { Id = "condition", Name = "Condition", Category = "Control Flow", Icon = "rule", Color = "#FF9800" },
        new NodeDefinition { Id = "parallel", Name = "Parallel", Category = "Control Flow", Icon = "call_split", Color = "#9C27B0" },
        new NodeDefinition { Id = "delay", Name = "Delay", Category = "Control Flow", Icon = "timer", Color = "#607D8B" },
        new NodeDefinition { Id = "setVariable", Name = "Set Variable", Category = "Variables", Icon = "assignment", Color = "#2196F3" },
        new NodeDefinition { Id = "getVariable", Name = "Get Variable", Category = "Variables", Icon = "visibility", Color = "#03A9F4" },
        new NodeDefinition { Id = "log", Name = "Log", Category = "Utilities", Icon = "article", Color = "#795548" },
        new NodeDefinition { Id = "httpRequest", Name = "HTTP Request", Category = "Integration", Icon = "cloud", Color = "#00BCD4" },
        new NodeDefinition { Id = "pluginAction", Name = "Plugin Action", Category = "Game", Icon = "extension", Color = "#E91E63" },
        new NodeDefinition { Id = "aiInference", Name = "AI Inference", Category = "AI", Icon = "psychology", Color = "#673AB7" },
        new NodeDefinition { Id = "deviceCapture", Name = "Device Capture", Category = "Device", Icon = "camera_alt", Color = "#009688" },
        new NodeDefinition { Id = "deviceInput", Name = "Device Input", Category = "Device", Icon = "touch_app", Color = "#009688" },
        new NodeDefinition { Id = "perception", Name = "Perception", Category = "AI", Icon = "visibility", Color = "#673AB7" },
        new NodeDefinition { Id = "transform", Name = "Transform", Category = "Data", Icon = "transform", Color = "#FF9800" },
        new NodeDefinition { Id = "filter", Name = "Filter", Category = "Data", Icon = "filter_list", Color = "#FF9800" },
        new NodeDefinition { Id = "loop", Name = "Loop", Category = "Control Flow", Icon = "loop", Color = "#9C27B0" },
        new NodeDefinition { Id = "branch", Name = "Branch", Category = "Control Flow", Icon = "call_split", Color = "#9C27B0" }
    };
    
    private string GetCategoryIcon(string category) => category switch
    {
        "Control Flow" => Icons.Material.Filled.CallSplit,
        "Variables" => Icons.Material.Filled.DataObject,
        "Utilities" => Icons.Material.Filled.Build,
        "Integration" => Icons.Material.Filled.Cloud,
        "Game" => Icons.Material.Filled.SportsEsports,
        "AI" => Icons.Material.Filled.Psychology,
        "Device" => Icons.Material.Filled.PhoneAndroid,
        "Data" => Icons.Material.Filled.Transform,
        _ => Icons.Material.Filled.Category
    };
    
    private void CreateNewWorkflow()
    {
        _workflowInstance = new VisualWorkflow
        {
            Name = "New Workflow",
            Description = "A new visual workflow"
        };
        NavigationManager.NavigateTo("/visual-scripting");
    }
    
    private async Task AddNode(string nodeTypeId)
    {
        // The VisualScriptingEditor component handles this
    }
    
    private async Task ExecuteWorkflow()
    {
        // Handled by VisualScriptingEditor component
    }
    
    private async Task CancelExecution() { }
    private async Task ValidateWorkflow() { }
    private async Task SaveWorkflow()
    {
        _showSaveDialog = true;
    }
    
    private async Task ConfirmSave()
    {
        if (Workflow != null)
        {
            Workflow.Name = _saveName;
            Workflow.Description = _saveDescription;
            // Save to database
            _showSaveDialog = false;
            Snackbar.Add("Workflow saved!", Severity.Success);
        }
    }
    
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}