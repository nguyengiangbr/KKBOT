@page "/visual-scripting"
@page "/visual-scripting/{workflowId:guid}"
@inject IVisualScriptingEngine Engine
@inject ILogger<VisualScripting> Logger
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <MudAppBar Elevation="1" Color="Color.Primary" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">Visual Scripting</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@SaveWorkflow" StartIcon="@Icons.Material.Filled.Save" Disabled="@(Workflow == null)">
            Save
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ExecuteWorkflow" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@(Workflow == null || _isExecuting)">
            @(_isExecuting ? "Running..." : "Run")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@CancelExecution" StartIcon="@Icons.Material.Filled.Stop" Disabled="@(!_isExecuting)">
            Stop
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@ValidateWorkflow" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="@(Workflow == null)">
            Validate
        </MudButton>
    </MudAppBar>
    
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Width="280" Class="mud-width-280">
        <MudNavMenu>
            <MudNavLink href="/visual-scripting" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Workflows</MudNavLink>
            <MudNavLink href="/visual-scripting/new" Icon="@Icons.Material.Filled.Add">New Workflow</MudNavLink>
        </MudNavMenu>
        
        <MudDivider Class="my-3" />
        
        <MudText Typo="Typo.subtitle2" Class="px-3 mb-2">Node Palette</MudText>
        <MudTextField @bind-Value="_searchNodeType" Placeholder="Search nodes..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="px-3 mb-3" Dense="true" />
        
        <MudList Dense="true" Class="px-2">
            @foreach (var group in _filteredNodeGroups)
            {
                <MudExpansionPanels>
                    <MudExpansionPanel Text="@group.Key" Icon="@GetCategoryIcon(group.Key)">
                        <MudList>
                            @foreach (var nodeDef in group.OrderBy(d => d.Name))
                            {
                                <MudListItem OnClick="@(() => AddNode(nodeDef.Id))" Class="mud-py-1">
                                    <MudIcon Icon="@nodeDef.Icon" Size="Size.Small" Class="mr-2" Style="color: @nodeDef.Color" />
                                    @nodeDef.Name
                                </MudListItem>
                            }
                        </MudList>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudList>
    </MudDrawer>
    
    <MudMainContent Class="pa-0">
        <MudGrid Class="h-100">
            <MudItem xs="12" Class="h-100 d-flex flex-column">
                @if (Workflow == null)
                {
                    <MudPaper Class="ma-4 d-flex flex-column align-center justify-center h-100" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="@(IconSize.Large * 3)" Color="Color.Primary" Class="mb-4" />
                        <MudText Typo="Typo.h5" Class="mb-2">Welcome to Visual Scripting</MudText>
                        <MudText Typo="Typo.body1" Class="mb-4 mud-text-secondary">Create visual workflows by dragging nodes and connecting them together.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateNewWorkflow" StartIcon="@Icons.Material.Filled.Add" Class="mt-2">
                            Create New Workflow
                        </MudButton>
                    </MudPaper>
                }
                else
                {
                    <VisualScriptingEditor 
                        Workflow="@Workflow" 
                        WorkflowChanged="@WorkflowChanged"
                        ReadOnly="@_isExecuting" />
                }
            </MudItem>
        </MudGrid>
    </MudMainContent>
</MudContainer>

<MudDialog @bind-Visible="@_showSaveDialog" MaxWidth="MaxWidth.Medium">
    <DialogContent>
        <MudText Typo="Typo.h6">Save Workflow</MudText>
        <MudTextField @bind-Value="_saveName" Label="Workflow Name" Required="true" />
        <MudTextField @bind-Value "_saveDescription" Label="Description" Multiline="true" Rows="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showSaveDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmSave">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
