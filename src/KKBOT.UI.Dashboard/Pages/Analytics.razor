// DTOs for the analytics components
public record MarketplaceOverview
{
    public long TotalPlugins { get; init; }
    public long PublishedPlugins { get; init; }
    public long TotalPublishers { get; init; }
    public long VerifiedPublishers { get; init; }
    public long TotalDownloads { get; init; }
    public long MonthlyActiveUsers { get; init; }
    public double AverageRating { get; init; }
    public long TotalReviews { get; init; }
    public long PendingModeration { get; init; }
    public double ConversionRate { get; init; }
    public Dictionary<string, long> PluginsByCategory { get; init; } = new();
    public Dictionary<string, long> PluginsByStatus { get; init; } = new();
}

public record Dashboard
{
    public Guid Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public string OwnerId { get; init; } = string.Empty;
    public string TenantId { get; init; } = string.Empty;
    public bool IsPublic { get; init; }
    public string LayoutJson { get; init; } = "[]";
    public string Theme { get; init; } = "light";
    public DateTime CreatedAt { get; init; }
    public DateTime UpdatedAt { get; init; }
}

public record Report
{
    public Guid Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public string Category { get; init; } = string.Empty;
    public string OwnerId { get; init; } = string.Empty;
    public string TemplateJson { get; init; } = "{}";
    public string DataSourceJson { get; init; } = "{}";
    public ReportFormat DefaultFormat { get; init; }
    public bool IsScheduled { get; init; }
    public string CronExpression { get; init; } = string.Empty;
    public DateTime CreatedAt { get; init; }
    public DateTime UpdatedAt { get; init; }
}

public enum ReportFormat
{
    Pdf,
    Excel,
    Csv,
    Json,
    Html,
    Png,
    Parquet
}

public record MetricDefinition
{
    public Guid Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string DisplayName { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public string Unit { get; init; } = string.Empty;
    public MetricType Type { get; init; }
    public string Category { get; init; } = string.Empty;
    public string Tags { get; init; } = string.Empty;
    public string QueryJson { get; init; } = "{}";
    public string DataSourceId { get; init; } = string.Empty;
    public int RetentionDays { get; init; } = 90;
    public int AggregationIntervalSeconds { get; init; } = 60;
    public AggregationFunction Aggregation { get; init; } = AggregationFunction.Avg;
    public bool IsActive { get; init; } = true;
    public DateTime CreatedAt { get; init; }
    public DateTime UpdatedAt { get; init; }
}

public enum MetricType
{
    Counter,
    Gauge,
    Histogram,
    Summary,
    Rate
}

public enum AggregationFunction
{
    Sum,
    Avg,
    Min,
    Max,
    Count,
    Percentile50,
    Percentile90,
    Percentile95,
    Percentile99,
    StdDev,
    Variance
}

public record ForecastModel
{
    public Guid Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public ForecastAlgorithm Algorithm { get; init; }
    public Guid MetricId { get; init; }
    public string ModelPath { get; init; } = string.Empty;
    public bool IsTrained { get; init; }
    public bool IsActive { get; init; } = true;
    public DateTime CreatedAt { get; init; }
    public DateTime UpdatedAt { get; init; }
}

public enum ForecastAlgorithm
{
    Prophet,
    ARIMA,
    SARIMA,
    ETS,
    LSTM,
    GRU,
    Transformer,
    NBEATS,
    TFT,
    AutoARIMA,
    AutoETS,
    LightGBM,
    XGBoost,
    LinearRegression,
    RandomForest,
    Custom
}

public record CohortAnalysis
{
    public Guid Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public CohortType Type { get; init; }
    public DateTime StartDate { get; init; }
    public DateTime EndDate { get; init; }
    public string CohortDefinition { get; init; } = string.Empty;
    public string MetricDefinition { get; init; } = string.Empty;
    public int PeriodCount { get; init; } = 12;
    public PeriodGranularity Granularity { get; init; }
    public DateTime CreatedAt { get; init; }
}

public enum CohortType
{
    Acquisition,
    Behavioral,
    Predictive
}

public enum PeriodGranularity
{
    Daily,
    Weekly,
    Monthly,
    Quarterly
}

public record FunnelAnalysis
{
    public Guid Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public List<FunnelStep> Steps { get; init; } = new();
    public DateTime StartDate { get; init; }
    public DateTime EndDate { get; init; }
    public string FilterJson { get; init; } = "{}";
    public DateTime CreatedAt { get; init; }
}

public record FunnelStep
{
    public int Order { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public string EventName { get; init; } = string.Empty;
    public string FilterJson { get; init; } = "{}";
    public bool IsRequired { get; init; } = true;
}