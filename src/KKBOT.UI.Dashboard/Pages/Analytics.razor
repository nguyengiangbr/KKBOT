@page "/analytics"
@inject HttpClient Http
@inject ILogger<Analytics> Logger

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h4" Class="mb-4">Analytics & BI</MudText>

    <MudTabs>
        <MudTabPanel Text="Overview">
            <OverviewTab />
        </MudTabPanel>
        <MudTabPanel Text="Dashboards">
            <DashboardsTab />
        </MudTabPanel>
        <MudTabPanel Text="Reports">
            <ReportsTab />
        </MudTabPanel>
        <MudTabPanel Text="Metrics">
            <MetricsTab />
        </MudTabPanel>
        <MudTabPanel Text="Alerts">
            <AlertsTab />
        </MudTabPanel>
        <MudTabPanel Text="Anomalies">
            <AnomaliesTab />
        </MudTabPanel>
        <MudTabPanel Text="Forecasting">
            <ForecastingTab />
        </MudTabPanel>
        <MudTabPanel Text="KPIs">
            <KpisTab />
        </MudTabPanel>
        <MudTabPanel Text="Cohorts">
            <CohortsTab />
        </MudTabPanel>
        <MudTabPanel Text="Funnels">
            <FunnelsTab />
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    // Overview Tab Component
    class OverviewTab : ComponentBase
    {
        [Inject] protected HttpClient Http { get; set; } = default!;
        [Inject] protected ILogger<OverviewTab> Logger { get; set; } = default!;

        private MarketplaceOverview? _overview;
        private bool _isLoading = true;

        protected override async Task OnInitializedAsync()
        {
            await LoadData();
        }

        async Task LoadData()
        {
            _isLoading = true;
            try
            {
                _overview = await Http.GetFromJsonAsync<MarketplaceOverview>("api/v1/analytics/overview");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load overview");
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    // Dashboards Tab Component
    class DashboardsTab : ComponentBase
    {
        [Inject] protected HttpClient Http { get; set; } = default!;
        [Inject] protected ILogger<DashboardsTab> Logger { get; set; } = default!;

        private List<Dashboard> _dashboards = new();
        private bool _isLoading = true;
        private string _searchString = "";
        private int _currentPage = 1;
        private int _pageSize = 10;

        protected override async Task OnInitializedAsync()
        {
            await LoadDashboards();
        }

        async Task LoadDashboards()
        {
            _isLoading = true;
            try
            {
                var dashboards = await Http.GetFromJsonAsync<List<Dashboard>>($"api/v1/analytics/dashboards?page={_currentPage}&pageSize={_pageSize}");
                _dashboards = dashboards ?? new();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load dashboards");
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

