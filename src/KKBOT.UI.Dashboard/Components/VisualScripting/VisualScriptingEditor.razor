    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeCanvasAsync();
            if (Workflow != null)
            {
                await RenderWorkflowAsync();
            }
        }
    }

    private async Task InitializeCanvasAsync()
    {
        if (_canvas == null) return;
        await JS.InvokeVoidAsync("visualScripting.initializeCanvas", _canvas.Ref, DotNetObjectReference.Create(this));
    }

    private async Task RenderWorkflowAsync()
    {
        if (Workflow == null || _canvas == null) return;
        await JS.InvokeVoidAsync("visualScripting.renderWorkflow", _canvas.Ref, JsonSerializer.Serialize(Workflow));
    }

    [JSInvokable]
    public async Task OnNodeClick(string nodeId)
    {
        var node = Workflow?.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node != null)
        {
            _selectedNode = node;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnCanvasClick(double x, double y)
    {
        _selectedNode = null;
        _connectingFromNode = null;
        _connectingFromPort = null;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnNodeDragStart(string nodeId, double x, double y)
    {
        if (ReadOnly) return;
        var node = Workflow?.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node != null)
        {
            _isDragging = true;
            _draggedNode = node;
            _mousePosition = new Point(x, y);
        }
    }

    [JSInvokable]
    public async Task OnNodeDrag(double x, double y)
    {
        if (!_isDragging || _draggedNode == null) return;
        
        var dx = x - _mousePosition.X;
        var dy = y - _mousePosition.Y;
        
        _draggedNode!.Position.X += dx;
        _draggedNode.Position.Y += dy;
        _mousePosition = new Point(x, y);
        
        await JS.InvokeVoidAsync("visualScripting.updateNodePosition", _draggedNode.Id, _draggedNode.Position.X, _draggedNode.Position.Y);
    }

    [JSInvokable]
    public async Task OnNodeDragEnd()
    {
        _isDragging = false;
        _draggedNode = null;
        if (Workflow != null)
        {
            await WorkflowChanged.InvokeAsync(Workflow);
        }
    }

    [JSInvokable]
    public async Task OnPortClick(string nodeId, string portId, bool isInput)
    {
        if (ReadOnly) return;
        
        var node = Workflow?.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node == null) return;

        var port = isInput ? node.Inputs.GetValueOrDefault(portId) : node.Outputs.GetValueOrDefault(portId);
        if (port == null) return;

        if (_connectingFromNode == null)
        {
            _connectingFromNode = node;
            _connectingFromPort = portId;
        }
        else
        {
            if (isInput)
            {
                var edge = new WorkflowEdge
                {
                    SourceNodeId = _connectingFromNode.Id,
                    SourcePortId = _connectingFromPort!,
                    TargetNodeId = node.Id,
                    TargetPortId = portId
                };
                
                if (Workflow != null)
                {
                    Workflow.Edges.Add(edge);
                    await WorkflowChanged.InvokeAsync(Workflow);
                    await RenderWorkflowAsync();
                }
            }
            else
            {
                var edge = new WorkflowEdge
                {
                    SourceNodeId = node.Id,
                    SourcePortId = portId,
                    TargetNodeId = _connectingFromNode.Id,
                    TargetPortId = _connectingFromPort!
                };
                
                if (Workflow != null)
                {
                    Workflow.Edges.Add(edge);
                    await WorkflowChanged.InvokeAsync(Workflow);
                    await RenderWorkflowAsync();
                }
            }
            
            _connectingFromNode = null;
            _connectingFromPort = null;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnDeleteNode(string nodeId)
    {
        if (ReadOnly || Workflow == null) return;
        
        var node = Workflow.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node != null)
        {
            Workflow.Edges.RemoveAll(e => e.SourceNodeId == nodeId || e.TargetNodeId == nodeId);
            Workflow.Nodes.Remove(node);
            
            if (_selectedNode?.Id == nodeId)
            {
                _selectedNode = null;
            }
            
            await WorkflowChanged.InvokeAsync(Workflow);
            await RenderWorkflowAsync();
        }
    }

    [JSInvokable]
    public async Task OnDeleteEdge(string edgeId)
    {
        if (ReadOnly || Workflow == null) return;
        
        Workflow.Edges.RemoveAll(e => e.Id == edgeId);
        await WorkflowChanged.InvokeAsync(Workflow);
        await RenderWorkflowAsync();
    }

    [JSInvokable]
    public async Task OnCanvasPan(double dx, double dy)
    {
        _panOffset.X += dx;
        _panOffset.Y += dy;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCanvasZoom(double zoom)
    {
        _zoom = Math.Clamp(zoom, 0.1, 3.0);
        StateHasChanged();
    }

    private async Task AddNode(string nodeTypeId)
    {
        if (ReadOnly || Workflow == null) return;
        
        var definition = _nodeDefinitions.FirstOrDefault(d => d.Id == nodeTypeId);
        if (definition == null) return;

        var node = new WorkflowNode
        {
            Id = Guid.NewGuid().ToString("N"),
            NodeTypeId = definition.Id,
            Name = definition.Name,
            Description = definition.Description,
            Position = new NodePosition { X = 100 + Workflow.Nodes.Count * 50, Y = 100 + Workflow.Nodes.Count * 50 }
        };

        foreach (var portDef in definition.InputPorts)
        {
            node.Inputs[portDef.Id] = new NodePort
            {
                Id = portDef.Id,
                Name = portDef.Name,
                Description = portDef.Description,
                DataType = portDef.DataType,
                IsRequired = portDef.IsRequired,
                IsMultiple = portDef.IsMultiple,
                DefaultValue = portDef.DefaultValue,
                ValidationRules = portDef.ValidationRules
            };
        }

        foreach (var portDef in definition.OutputPorts)
        {
            node.Outputs[portDef.Id] = new NodePort
            {
                Id = portDef.Id,
                Name = portDef.Name,
                Description = portDef.Description,
                DataType = portDef.DataType,
                IsRequired = portDef.IsRequired,
                IsMultiple = portDef.IsMultiple,
                DefaultValue = portDef.DefaultValue,
                ValidationRules = portDef.ValidationRules
            };
        }

        foreach (var propDef in definition.Properties)
        {
            node.Properties[propDef.Id] = propDef.DefaultValue ?? GetDefaultValue(propDef.DataType);
        }

        Workflow.Nodes.Add(node);
        await WorkflowChanged.InvokeAsync(Workflow);
        await RenderWorkflowAsync();
        
        Snackbar.Add($"Added {definition.Name} node", Severity.Success);
    }

    private object? GetDefaultValue(PropertyDataType dataType)
    {
        return dataType switch
        {
            PropertyDataType.String => "",
            PropertyDataType.Integer => 0,
            PropertyDataType.Number => 0.0,
            PropertyDataType.Boolean => false,
            PropertyDataType.Json => "{}",
            PropertyDataType.Array => new List<object>(),
            PropertyDataType.Enum => "",
            _ => null
        };
    }

    private async Task ExecuteWorkflow()
    {
        if (Workflow == null) return;
        
        _isExecuting = true;
        _executionCts = new CancellationTokenSource();
        _lastExecutionResult = null;
        StateHasChanged();

        try
        {
            var result = await Engine.ExecuteWorkflowAsync(Workflow!, null, _executionCts.Token);
            _lastExecutionResult = result;
            
            if (result.Status == WorkflowExecutionStatus.Completed)
            {
                Snackbar.Add("Workflow executed successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Workflow failed: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Execution cancelled", Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Workflow execution failed");
            Snackbar.Add($"Execution error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExecuting = false;
            _executionCts = null;
            StateHasChanged();
        }
    }

    private async Task CancelExecution()
    {
        if (_executionCts != null)
        {
            _executionCts.Cancel();
            Snackbar.Add("Cancelling execution...", Severity.Info);
        }
    }

    private async Task SaveWorkflow()
    {
        if (Workflow == null) return;
        
        _workflowJson = JsonSerializer.Serialize(Workflow, new JsonSerializerOptions { WriteIndented = true });
        Snackbar.Add("Workflow saved!", Severity.Success);
    }

    private async Task LoadWorkflow()
    {
        if (string.IsNullOrWhiteSpace(_workflowJson)) return;
        
        try
        {
            var workflow = JsonSerializer.Deserialize<VisualWorkflow>(_workflowJson);
            if (workflow != null)
            {
                Workflow = workflow;
                await WorkflowChanged.InvokeAsync(Workflow);
                await RenderWorkflowAsync();
                Snackbar.Add("Workflow loaded!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load workflow: {ex.Message}", Severity.Error);
        }
    }

    private async Task ValidateWorkflow()
    {
        if (Workflow == null) return;
        
        var result = await Engine.ValidateWorkflowAsync(Workflow);
        
        if (result.IsValid)
        {
            Snackbar.Add("Workflow is valid!", Severity.Success);
        }
        else
        {
            var errors = string.Join("\n", result.Errors.Select(e => e.Message));
            Snackbar.Add($"Validation failed:\n{errors}", Severity.Error);
        }
    }

    private void ZoomIn() => _zoom = Math.Min(_zoom + 0.1, 3.0);
    private void ZoomOut() => _zoom = Math.Max(_zoom - 0.1, 0.1);
    private void ResetZoom() => _zoom = 1.0;

    private IEnumerable<IGrouping<string, NodeDefinition>> FilteredNodeDefinitions =>
        _nodeDefinitions
            .Where(d => string.IsNullOrWhiteSpace(_searchNodeType) || 
                       d.Name.Contains(_searchNodeType, StringComparison.OrdinalIgnoreCase) ||
                       d.Category.Contains(_searchNodeType, StringComparison.OrdinalIgnoreCase))
            .GroupBy(d => d.Category)
            .SelectMany(g => g.OrderBy(d => d.Name));

    public async ValueTask DisposeAsync()
    {
        _executionCts?.Cancel();
        _executionCts?.Dispose();
        
        if (_canvas != null)
        {
            await JS.InvokeVoidAsync("visualScripting.dispose", _canvas.Ref);
        }
    }

    public record Point(double X, double Y);
}