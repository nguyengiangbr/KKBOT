<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>KKBOT.Agent.Coordination.Grpc</AssemblyName>
    <RootNamespace>KKBOT.Agent.Coordination.Grpc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KKBOT.Agent.Coordination.Abstractions\KKBOT.Agent.Coordination.Abstractions.csproj" />
    <ProjectReference Include="..\KKBOT.Agent.Coordination\KKBOT.Agent.Coordination.csproj" />
    <ProjectReference Include="..\KKBOT.Observability\KKBOT.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="coordination.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>