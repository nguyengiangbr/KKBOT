<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0
    <Nullable>enable
    <ImplicitUsings>enable
    <GenerateDocumentationFile>true
    <AssemblyName>KKBOT.LicenseServer
    <RootNamespace>KKBOT.LicenseServer
    <UserSecretsId>KKBOT-LicenseServer-Secrets
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KKBOT.Licensing\KKBOT.Licensing.csproj" />
    <ProjectReference Include="..\KKBOT.Observability\KKBOT.Observability.csproj" />
    <ProjectReference Include="..\KKBOT.Security\KKBOT.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="FluentValidation.AspNetCore" />
  </ItemGroup>

</Project>
