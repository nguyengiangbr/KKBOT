<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>KKBOT.Collaboration</AssemblyName>
    <RootNamespace>KKBOT.Collaboration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KKBOT.Application\KKBOT.Application.csproj" />
    <ProjectReference Include="..\KKBOT.Domain\KKBOT.Domain.csproj" />
    <ProjectReference Include="..\KKBOT.Identity\KKBOT.Identity.csproj" />
    <ProjectReference Include="..\KKBOT.Observability\KKBOT.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="System.Security.Claims" />
    <Using Include="KKBOT.Collaboration.Data" />
    <Using Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <Using Include="Swashbuckle.AspNetCore.Annotations" />
  </ItemGroup>

</Project>
