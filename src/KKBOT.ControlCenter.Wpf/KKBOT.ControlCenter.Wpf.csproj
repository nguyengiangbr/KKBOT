<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>KKBOT.ControlCenter.Wpf</AssemblyName>
    <RootNamespace>KKBOT.ControlCenter.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KKBOT.Application\KKBOT.Application.csproj" />
    <ProjectReference Include="..\KKBOT.Dashboard\KKBOT.Dashboard.csproj" />
    <ProjectReference Include="..\KKBOT.Orchestration\KKBOT.Orchestration.csproj" />
    <ProjectReference Include="..\KKBOT.Plugins.Loader\KKBOT.Plugins.Loader.csproj" />
    <ProjectReference Include="..\KKBOT.Plugins.Wpf\KKBOT.Plugins.Wpf.csproj" />
    <ProjectReference Include="..\KKBOT.Navigation\KKBOT.Navigation.csproj" />
    <ProjectReference Include="..\KKBOT.Security\KKBOT.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>