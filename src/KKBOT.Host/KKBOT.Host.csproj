<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>KKBOT.Host</AssemblyName>
    <RootNamespace>KKBOT.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KKBOT.Application\KKBOT.Application.csproj" />
    <ProjectReference Include="..\KKBOT.Orchestration\KKBOT.Orchestration.csproj" />
    <ProjectReference Include="..\KKBOT.Dashboard\KKBOT.Dashboard.csproj" />
    <ProjectReference Include="..\KKBOT.Security\KKBOT.Security.csproj" />
    <ProjectReference Include="..\KKBOT.Observability\KKBOT.Observability.csproj" />
    <ProjectReference Include="..\KKBOT.Persistence\KKBOT.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>
</Project>